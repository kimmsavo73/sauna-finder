rules_version = '2';
// Saunaan reviews: anyone can read and add a review; nobody can edit or delete
// through the app (the project owner can still remove reviews in the Firebase console).
service cloud.firestore {
  match /databases/{database}/documents {
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['place', 'placeName', 'rating', 'text', 'name', 'tags', 'created'])
        && request.resource.data.keys().hasAll(['place', 'placeName', 'rating', 'text', 'name', 'tags', 'created'])
        && request.resource.data.place is string
        && request.resource.data.place.matches('^(node|way|relation)_[0-9]+$')
        && request.resource.data.placeName is string && request.resource.data.placeName.size() <= 120
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 800
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 9
        && request.resource.data.tags.hasOnly(['hot', 'soft', 'dip', 'quiet', 'busy', 'clean', 'value', 'beginner', 'social'])
        && request.resource.data.created == request.time;
      allow update, delete: if false;
    }
  }
}
